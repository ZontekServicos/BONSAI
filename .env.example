DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bonsai
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_QR_SECRET=replace-with-another-random-secret-of-at-least-32-bytes
CORS_ORIGIN=http://localhost:8443
COOKIE_SAME_SITE=strict
PORT=3001
NODE_ENV=development
PG_POOL_MAX=10
DIAS_CARENCIA=5
SERVE_WEB=false
# Enable only after defining the academy's billing policy.
BILLING_ENABLED=false
BILLING_AMOUNT=150.00
BILLING_DUE_DAY=10
# WhatsApp da loja (DDI+DDD+número). Sem ele, "Solicitar Compra" responde 503.
# WHATSAPP_LOJA=5511999990000
# Chave Pix da academia, enviada nas cobranças por WhatsApp. Sem ela, /notificacoes/cobrar responde 503.
# PIX_CHAVE=financeiro@suaacademia.com.br
# Optional for a separately hosted frontend. Same-origin deployment uses /api/v1.
VITE_API_URL=
# Somente desenvolvimento: exibe os botões "Professor" / "Aluno" no login (vite dev).
# Crie as contas antes com `pnpm demo:seed`. Ignorado em `vite build`.
VITE_DEMO_LOGIN=false
